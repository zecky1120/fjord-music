<% if video.thumbnail.present? %>
  <figure>
    <img src="<%= video.thumbnail %>" alt="<%= video.title %>">
  </figure>
<% else %>
<% end %>
<div>ユーザーネーム: <%= link_to "#{user_name(video.user)}", user_path(video.user) %></div>
<% if video.caption.present? %>
  <div>キャプション: <%= video.caption %></div>
<% end %>
<div>動画名: <%= link_to "#{video.title}", "#{video.url}", target: "_blank", rel: "noopener noreferrer" %></div>
<p><time>投稿日: <%= l video.created_at, formats: :long %></time></p>
<hr>
